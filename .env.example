# ===== 复制为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会上传）=====

# --- 配音 TTS（小米 MiMo，必配）---
# 获取: https://platform.xiaomimimo.com/console/api-keys
MIMO_API_KEY=sk-你的小米MiMo密钥
# TTS_PROVIDER=mimo          # 可选: mimo（默认）
# TTS_DEFAULT_VOICE=冰糖      # 预置音色: 冰糖/茉莉/苏打/白桦
# TTS_STYLE=用清晰、自然、适合短视频旁白的语气朗读

# --- 封面生图（agnes，可选）---
# AGNES_API_KEY=sk-你的agnes密钥
# AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# --- 热点采集（可选调参）---
# HOTSPOT_SOURCES=https://news.163.com/world/,https://news.sina.com.cn/world/,https://world.huanqiu.com/
# HOTSPOT_SCORE_THRESHOLD=6
# HOTSPOT_MAX_ITEMS=40

# --- 发布（抖音）---
# DOUYIN_ACCOUNT=你的抖音账号名

# --- 备用 TTS（可选）---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
